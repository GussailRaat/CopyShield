# =============================================================================
# CopyShield local settings. Copy to slurm/env.sh and fill in. slurm/env.sh is
# gitignored and sourced by the SLURM jobs. Do NOT commit real keys.
#   cp slurm/env.sh.template slurm/env.sh   &&   edit slurm/env.sh
# =============================================================================

# Shared Hugging Face cache used by SLURM jobs.
export HF_HOME="/shared/models/huggingface"
export HF_HUB_CACHE="/shared/models/huggingface/hub"
export HUGGINGFACE_HUB_CACHE="/shared/models/huggingface/hub"
export HF_HUB_OFFLINE=1

# Anthropic API key — required ONLY by the utility-eval step (AI-judge QA/
# non-literal scores). GPU pipeline jobs do not need it.
export ANTHROPIC_API_KEY=""

# Hugging Face token — required ONLY for the gated Llama models
# (meta-llama/Llama-3.1-8B, meta-llama/Llama-3.2-1B). Accept each model's
# license on its HF page first. Qwen models are ungated and already cached.
export HF_TOKEN=""
