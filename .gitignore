# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.env

# Trained model weights -- too large for GitHub (host on HuggingFace)
models/

# Activation tensors -- regenerated by activation.py
activations/

# Generated outputs -- regenerated by running the pipeline.
# Exception: calibrated thresholds (small, hard dependency at runtime)
outputs/*
!outputs/calibration/
!outputs/calibration/thresholds.json
outputs/calibration/calibration_distributions.png
outputs/calibration/raw_scores.json

# Raw / intermediate corpus files -- produced by scripts/data_prep/prepare_corpora.py
data/raw_books/
data/cleaned_books/
data/raw_neutral_books/
data/cleaned_neutral_books/
data/books_corpus.txt
data/neutral_books_corpus.txt

# Logging
wandb/
*.log

# Secrets — API keys / HF tokens sourced by SLURM jobs (never commit)
slurm/env.sh

# SLURM job logs
logs/
slurm/*.out
slurm/*.err

# Misc
.DS_Store

# ============================================================
# PUBLIC-RELEASE EXCLUSIONS
# ============================================================
